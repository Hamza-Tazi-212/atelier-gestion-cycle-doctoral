@startuml
left to right direction
skinparam shadowing false
title GCD+ · Architecture de l’application
actor "Utilisateur" as User
node "Navigateur" {
  component "Interface web\nBootstrap et JavaScript" as UI
  component "Caméra et aperçu\nConversion locale en PDF" as Scan
}
node "Application Laravel" {
  component "Routes web et contrôleurs" as Web
  component "Session, authentification\net autorisations" as Auth
  component "Services et modèles métier" as Domain
  component "Vues Blade" as Views
}
database "Base SQL\nSQLite en démonstration" as DB
folder "Stockage privé\nPDF des dossiers" as Docs
cloud "Transport de courriel\nJournal en démonstration" as Mail
User --> UI
UI --> Scan : préparer une pièce
UI --> Web : requêtes HTTP et dépôt PDF
Web --> Auth : vérifier l’accès
Web --> Domain : traiter les opérations
Web --> Views : générer les pages
Auth --> DB : comptes, sessions
Domain --> DB : sujets, dossiers, avis
Domain --> Docs : lire et écrire les pièces
Domain --> Mail : notifier les décisions
@enduml
